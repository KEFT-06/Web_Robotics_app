          },
          {
            "node": "Meshy AI API (Image/Video to 3D)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Vision (Morphology)": {
      "main": [
        [
          {
            "node": "Code (URDF & Gazebo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Meshy AI API (Image/Video to 3D)": {
      "main": [
        [
          {
            "node": "Code (URDF & Gazebo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code (URDF & Gazebo)": {
      "main": [
        [
          {
            "node": "Deploy to ROS 2 (Ubuntu 22.04)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "df1611ec-4581-4e7d-a19b-c0b7ec17c6b9",
